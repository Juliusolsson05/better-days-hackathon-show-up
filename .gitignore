.env
.env.local
.DS_Store

# Supabase CLI local state
supabase/.branches
supabase/.temp
.branches

# IDE
.idea/
*.iml
.vscode/

.env.functions

# ClickPipes is declarative, but its state and operator tfvars contain live infrastructure
# identifiers and may contain secrets from older Terraform/provider versions. The lock file is
# intentionally committed; it is the reviewed provider supply-chain pin.
infra/clickhouse-cdc/.terraform/
infra/clickhouse-cdc/*.tfstate
infra/clickhouse-cdc/*.tfstate.*
infra/clickhouse-cdc/*.tfvars
infra/clickhouse-cdc/crash.log

# Agent worktrees are checkouts of this repo, not content of it
.claude/

# Venue ingestion creates local Python bytecode; only source and corpus inputs belong here.
__pycache__/
*.pyc
