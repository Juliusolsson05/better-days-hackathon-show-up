# Edge function secrets ONLY. Supabase reserves the SUPABASE_ prefix, so
# `supabase secrets set --env-file .env` rejects the whole file if those are present --
# and SUPABASE_URL / ANON_KEY / SERVICE_ROLE_KEY are auto-injected into the runtime anyway.
#
#   supabase secrets set --env-file .env.functions

CLICKHOUSE_URL=https://xxxxx.us-west-2.aws.clickhouse.cloud:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
VOYAGE_API_KEY=
ANTHROPIC_API_KEY=
# Random 32+ character credential for the dashboard's matching-only operator action. This is not a
# database key and cannot bypass RLS. Generate it with: openssl rand -hex 32
MATCHING_JOB_SECRET=
