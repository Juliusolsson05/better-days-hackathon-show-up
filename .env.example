# Copy to .env and fill in. .env is gitignored -- never commit real values.
#
# The backend selector, URL, and anon key at the top are public configuration by design (the
# anon key is safe to ship; RLS is what protects the data) and reach Flutter via --dart-define.
# Everything below them is server-only and goes into Supabase function secrets:
#
#   supabase secrets set --env-file .env

# Real API integration is the default. Set this to false only for an intentional fixture-only
# app run; leaving the backend ambiguous previously made device rehearsals silently use mocks.
USE_SUPABASE=true
SUPABASE_URL=
SUPABASE_ANON_KEY=

SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

CLICKHOUSE_URL=https://xxxxx.us-west-2.aws.clickhouse.cloud:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

VOYAGE_API_KEY=
ANTHROPIC_API_KEY=

SENTRY_DSN=
SENTRY_ORG=nordwebb
SENTRY_PROJECT=show-up
