# Copy to .env and fill in. .env is gitignored -- never commit real values.
#
# The backend selector, URL, and anon key at the top are public configuration by design (the
# anon key is safe to ship; RLS is what protects the data) and reach Flutter via --dart-define.
# The function-runtime values below are server-only and go into Supabase function secrets:
#
#   copy only that block to .env.functions
#   supabase secrets set --env-file .env.functions

# Real API integration is the default. Set this to false only for an intentional fixture-only
# app run; leaving the backend ambiguous previously made device rehearsals silently use mocks.
USE_SUPABASE=true
SUPABASE_URL=
SUPABASE_ANON_KEY=

SUPABASE_SERVICE_ROLE_KEY=

CLICKHOUSE_URL=https://xxxxx.us-west-2.aws.clickhouse.cloud:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

VOYAGE_API_KEY=
ANTHROPIC_API_KEY=

# The remaining values are operator/deployment credentials. Do not upload them as function
# secrets: edge code has no reason to control ClickHouse Cloud or administer Postgres.
SUPABASE_DB_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# ClickHouse Cloud management credentials provision ClickPipes; unlike the SQL credentials above,
# these authorize control-plane changes and are consumed only by Terraform.
CLICKHOUSE_CLOUD_ORGANIZATION_ID=
CLICKHOUSE_CLOUD_SERVICE_ID=
CLICKHOUSE_CLOUD_API_KEY=
CLICKHOUSE_CLOUD_API_SECRET=
CLICKPIPES_POSTGRES_PASSWORD=

SENTRY_DSN=
SENTRY_ORG=nordwebb
SENTRY_PROJECT=show-up
