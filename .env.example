# Copy to .env and fill in. .env is gitignored -- never commit real values.
#
# The two SUPABASE_ values at the top are public by design (the anon key is safe to ship;
# RLS is what protects the data) and reach Flutter via --dart-define. Everything below
# them is server-only and goes into Supabase function secrets:
#
#   supabase secrets set --env-file .env

SUPABASE_URL=
SUPABASE_ANON_KEY=

SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

CLICKHOUSE_URL=https://xxxxx.us-west-2.aws.clickhouse.cloud:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

VOYAGE_API_KEY=
ANTHROPIC_API_KEY=
